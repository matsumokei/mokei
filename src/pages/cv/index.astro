  },
];

const educationItems = [
  {
    date: '2021-04',
    title: 'Master degree Physics at Tokyo University of Science',
    description: 'Nikuni laboratory.',
  },
  {
    date: '2017-04',
    title: 'Bachelor degree Physics at Tokyo University of Science',
    description: 'Physics department.',
